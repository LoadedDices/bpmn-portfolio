      <bpmndi:BPMNShape id="gw2_di" bpmnElement="gw2" isMarkerVisible="true">
        <dc:Bounds x="826" y="107.5" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="806" y="167.5" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_end_di" bpmnElement="gw_end" isMarkerVisible="true">
        <dc:Bounds x="1756" y="113.5" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_reco_di" bpmnElement="t_reco">
        <dc:Bounds x="1036" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_asm_wo_di" bpmnElement="t_asm_wo">
        <dc:Bounds x="1016" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_handoff_di" bpmnElement="t_handoff">
        <dc:Bounds x="1886" y="99" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_agree_di" bpmnElement="t_agree">
        <dc:Bounds x="1216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <dc:Bounds x="2066" y="120.5" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2039" y="166.5" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_replace_di" bpmnElement="t_replace">
        <dc:Bounds x="1396" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="t_asm_rest_di" bpmnElement="t_asm_rest">
        <dc:Bounds x="1576" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
