<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_1" name="Message" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process_Op" name="Сытый зайка — Система доставки" processRef="Process_Op" />
    <bpmn:participant id="Participant_Pool_Buyer" name="Покупатель" />
    <bpmn:messageFlow id="mf1" name="Заказ" sourceRef="Participant_Pool_Buyer" targetRef="start" />
    <bpmn:messageFlow id="mf2" name="Звонок: список и альтернативы" sourceRef="t_call" targetRef="Participant_Pool_Buyer" />
    <bpmn:messageFlow id="mf3" name="Решение по заменам" sourceRef="Participant_Pool_Buyer" targetRef="t_agree" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Op" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Op">
      <bpmn:lane id="lane_op" name="Оператор">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_call</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asm_wo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_handoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_agree</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_replace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asm_rest</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Поступил заказ">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:task id="t_check" name="Проверить наличие позиций на складе">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw1" name="Все товары в наличии?" gatewayDirection="Diverging" default="f4">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_call" name="Позвонить покупателю">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_asm" name="Собрать заказ">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw2" name="Покупатель ответил?" gatewayDirection="Diverging" default="f7">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_end" name="" gatewayDirection="Converging">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_reco" name="Подобрать замены (система рекомендаций)">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_asm_wo" name="Собрать заказ без отсутствующих товаров">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_handoff" name="Передать заказ курьеру">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_agree" name="Согласовать замены с покупателем">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Заказ передан курьеру">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="t_replace" name="Заменить или исключить товары">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_asm_rest" name="Собрать оставшийся заказ">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_check" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_check" targetRef="gw1" />
    <bpmn:sequenceFlow id="f3" name="Нет" sourceRef="gw1" targetRef="t_call">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" name="Да" sourceRef="gw1" targetRef="t_asm" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_call" targetRef="gw2" />
    <bpmn:sequenceFlow id="f6" name="Ответил" sourceRef="gw2" targetRef="t_reco">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Ответил</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" name="Не ответил" sourceRef="gw2" targetRef="t_asm_wo" />
    <bpmn:sequenceFlow id="f8" sourceRef="t_reco" targetRef="t_agree" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_agree" targetRef="t_replace" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_replace" targetRef="t_asm_rest" />
    <bpmn:sequenceFlow id="f11" sourceRef="t_asm_rest" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f12" sourceRef="t_asm" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f13" sourceRef="t_asm_wo" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f14" sourceRef="gw_end" targetRef="t_handoff" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_handoff" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_Process_Op_di" bpmnElement="Participant_Process_Op" isHorizontal="true">
        <dc:Bounds x="20" y="20" width="2142" height="415" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_op_di" bpmnElement="lane_op" isHorizontal="true">
        <dc:Bounds x="50" y="20" width="2112" height="415" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_Pool_Buyer_di" bpmnElement="Participant_Pool_Buyer" isHorizontal="true">
        <dc:Bounds x="20" y="495" width="2142" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="140" y="127.5" width="36" height="36" />
        <bpmndi:BPMNLabel>
