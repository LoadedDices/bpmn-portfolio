<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Message_1" name="Message" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Process_Op" name="Сытый зайка — доставка" processRef="Process_Op" />
    <bpmn:participant id="Participant_Pool_Buyer" name="Покупатель" />
    <bpmn:messageFlow id="mf1" name="Заказ (опция замены)" sourceRef="Participant_Pool_Buyer" targetRef="start" />
    <bpmn:messageFlow id="mf2" name="Push: нет части товаров" sourceRef="t_push" targetRef="Participant_Pool_Buyer" />
    <bpmn:messageFlow id="mf3" name="Выбор замены" sourceRef="Participant_Pool_Buyer" targetRef="ev_msg" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Op" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Op">
      <bpmn:lane id="lane_op" name="Оператор (шаги «приложение» — авто)">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_collect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_asm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_push</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_reco</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_handoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_gw</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_collect_repl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ev_timer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_collect_chosen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_remove2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Поступил заказ">
      <bpmn:outgoing>f1</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_1" />
    </bpmn:startEvent>
    <bpmn:task id="t_check" name="Проверить наличие позиций на складе">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw1" name="Все товары в наличии?" gatewayDirection="Diverging" default="f4">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_collect" name="Собрать имеющиеся товары">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_asm" name="Собрать заказ">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="gw2" name="Опция замены в заказе?" gatewayDirection="Diverging" default="f8">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw_end" name="" gatewayDirection="Converging">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:incoming>f18</bpmn:incoming>
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="t_push" name="Отправить push о недостающих товарах (приложение)">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_remove" name="Исключить отсутствующие товары">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_reco" name="Подобрать замены (система рекомендаций)">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_handoff" name="Передать заказ курьеру">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="ev_gw" name="" gatewayDirection="Diverging">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:task id="t_collect_repl" name="Собрать подобранные замены">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Заказ передан курьеру">
      <bpmn:incoming>f21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ev_msg" name="Выбор замены получен">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_1" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ev_timer" name="Прошло 10 минут">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="t_collect_chosen" name="Собрать выбранные замены">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="t_remove2" name="Исключить товары (нет выбора за 10 мин)">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="t_check" />
    <bpmn:sequenceFlow id="f2" sourceRef="t_check" targetRef="gw1" />
    <bpmn:sequenceFlow id="f3" name="Нет" sourceRef="gw1" targetRef="t_collect">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f4" name="Да" sourceRef="gw1" targetRef="t_asm" />
    <bpmn:sequenceFlow id="f5" sourceRef="t_collect" targetRef="gw2" />
    <bpmn:sequenceFlow id="f6" name="Удалить товары" sourceRef="gw2" targetRef="t_remove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Удалить товары</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f7" name="Заменить на наш выбор" sourceRef="gw2" targetRef="t_reco">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Заменить на наш выбор</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f8" name="Спросить покупателя" sourceRef="gw2" targetRef="t_push" />
    <bpmn:sequenceFlow id="f9" sourceRef="t_reco" targetRef="t_collect_repl" />
    <bpmn:sequenceFlow id="f10" sourceRef="t_push" targetRef="ev_gw" />
    <bpmn:sequenceFlow id="f11" sourceRef="ev_gw" targetRef="ev_msg" />
    <bpmn:sequenceFlow id="f12" sourceRef="ev_gw" targetRef="ev_timer" />
    <bpmn:sequenceFlow id="f13" sourceRef="ev_msg" targetRef="t_collect_chosen" />
    <bpmn:sequenceFlow id="f14" sourceRef="ev_timer" targetRef="t_remove2" />
    <bpmn:sequenceFlow id="f15" sourceRef="t_asm" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f16" sourceRef="t_remove" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f17" sourceRef="t_collect_repl" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f18" sourceRef="t_collect_chosen" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f19" sourceRef="t_remove2" targetRef="gw_end" />
    <bpmn:sequenceFlow id="f20" sourceRef="gw_end" targetRef="t_handoff" />
    <bpmn:sequenceFlow id="f21" sourceRef="t_handoff" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
